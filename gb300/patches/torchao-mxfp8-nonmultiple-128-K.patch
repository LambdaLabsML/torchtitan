+def _quantize_2d_1x32_blocked(x, scaling_mode, offs, block_size=32):
+    """Cast a 2D activation to mxfp8 with tcgen05 block-scaled scales.
+
+    Prefers the CuTeDSL kernel and falls back to the Triton cast when the
+    contraction dim is not a multiple of 128.
+
+    Why: cutedsl_quantize_2d_1x32 asserts `K % 128 == 0`. GPT-OSS's expert
+    GEMMs all contract over `dim` = 2880, and 2880 % 128 = 64, so on that model
+    the CuTeDSL path can never be used and MXFP8 MoE training is unreachable --
+    not for any hardware reason, just this kernel's tiling. `pad_multiple` does
+    not help: it pads the per-expert token groups (M), not K.
+
+    The Triton cast has no such requirement (only contiguous, bfloat16, and an
+    inner block size <= 32), and every mxfp8 shape satisfies K % 32 == 0 by
+    definition of the 32-element scaling block. It is already the kernel this
+    same function uses for the *weights*, so it is not a new dependency -- only
+    the activations were routed through CuTeDSL.
+
+    The scales are then swizzled into the layout the SM100 grouped GEMM expects,
+    the same conversion this function already applies on its pre-quantized
+    `MXTensor` path -- but through the Triton kernel rather than the CUDA one,
+    because the CUDA one caps num_groups at 32 and this model has 128.
+    """
+    if x.shape[-1] % 128 == 0:
+        return mxfp8_quantize_2d_1x32_cutedsl(x, scaling_mode=scaling_mode, offs=offs)
+
+    from torchao.prototype.moe_training.kernels.mxfp8.quant import (
+        triton_mx_block_rearrange_2d_M_groups,
+    )
+
+    qdata, scales = triton_to_mxfp8_dim0(x.contiguous(), block_size, scaling_mode)
+    # The Triton swizzle, not mx_block_rearrange_2d_M_groups_cuda: the CUDA one
+    # asserts num_groups <= 32 (mxfp8_extension.cpp:203) and GPT-OSS-120B runs
+    # 128 expert groups per rank at expert_parallel_degree=1. The Triton kernel
+    # has no such cap. (Its docstring lists a third `output_group_start_offsets`
+    # argument; the registered op takes only two, and passing three raises.)
+    return qdata, triton_mx_block_rearrange_2d_M_groups(scales, offs)
+
+
